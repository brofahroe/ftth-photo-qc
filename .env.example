# Server Port & CORS
PORT=3001
CORS_ORIGIN=*

# Nextcloud WebDAV Configuration
# Contoh URL: https://cloud.perusahaan.com (atau dengan port https://cloud.perusahaan.com:8443)
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=admin
# Gunakan Password Akun atau App Password / Token dari menu Security di Nextcloud
NEXTCLOUD_PASSWORD=your_nextcloud_app_password
# Folder induk tempat menyimpan foto & laporan di Nextcloud
NEXTCLOUD_BASE_DIR=/PhotoQC
